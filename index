    <div style="text-align:center; margin-bottom: 28px;">
      <div style="width:36px; height:1px; background:var(--gold); margin:0 auto 14px;"></div>
      <div style="font-family:var(--font-sub); font-size:10px; letter-spacing:5px; color:var(--gold); text-transform:uppercase;">Your Answers</div>
      <div style="font-family:var(--font-main); font-size:20px; color:var(--ink); letter-spacing:3px; margin-top:6px;">填寫結果預覽</div>
    </div>
    <div class="result-content" id="resultContent"></div>
    <div class="result-actions">
      <button onclick="copyAnswers()">📋 複製全部答案</button>
      <button class="secondary" onclick="exportTXT()">📄 下載 .txt 文件</button>
      <button class="secondary" onclick="window.print()">🖨️ 列印 / 存PDF</button>
    </div>
  </div>
</div>

<script>
  // ===== Chip toggle =====
  document.querySelectorAll('.chip-group').forEach(group => {
    group.addEventListener('click', e => {
      const chip = e.target.closest('.chip');
      if (!chip) return;
      chip.classList.toggle('active');
    });
  });

  // ===== MBTI single select =====
  const mbtiGrid = document.querySelector('.mbti-grid');
  if (mbtiGrid) {
    mbtiGrid.addEventListener('click', e => {
      const cell = e.target.closest('.mbti-cell');
      if (!cell) return;
      mbtiGrid.querySelectorAll('.mbti-cell').forEach(c => c.classList.remove('active'));
      cell.classList.add('active');
    });
  }

  // ===== Energy Slider =====
  const slider = document.getElementById('energySlider');
  const sliderFill = document.getElementById('sliderFill');
  const sliderValue = document.getElementById('sliderValue');
  const sliderLabel = document.getElementById('sliderLabel');
  const sliderTicks = document.querySelectorAll('.slider-ticks span');

  const energyLabels = {
    1: '極度內向', 2: '偏內向', 3: '安靜型', 4: '選擇性社交', 5: '平衡型',
    6: '略外向', 7: '社交達人', 8: '派對動物', 9: '人群發電機', 10: '永動機'
  };

  function updateSlider() {
    const val = parseInt(slider.value, 10);
    const pct = ((val - 1) / 9) * 100;
    sliderFill.style.width = pct + '%';
    sliderValue.textContent = val;
    sliderLabel.textContent = energyLabels[val] || '';
    sliderTicks.forEach((tick, idx) => {
      tick.classList.toggle('passed', idx < val);
    });
  }
  if (slider) {
    slider.addEventListener('input', updateSlider);
    updateSlider();
  }

  // ===== Color swatches =====
  document.querySelectorAll('.color-row').forEach(row => {
    row.addEventListener('click', e => {
      const item = e.target.closest('.color-item');
      if (!item) return;
      item.classList.toggle('active');
    });
  });

  // ===== Weather items =====
  document.querySelectorAll('.weather-row').forEach(row => {
    row.addEventListener('click', e => {
      const item = e.target.closest('.weather-item');
      if (!item) return;
      row.querySelectorAll('.weather-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
    });
  });

  // ===== 收集答案 =====
  function collectAnswers() {
    const answers = [];
    const sections = document.querySelectorAll('.section');

    sections.forEach((sec) => {
      const secTitle = sec.querySelector('.section-title span:first-child');
      const secEn = sec.querySelector('.section-title .en');
      const titleText = secTitle ? secTitle.textContent.trim() : '';
      const enText = secEn ? secEn.textContent.trim() : '';
      answers.push({ type: 'section', title: titleText, en: enText });

      const cards = sec.querySelectorAll('.q-card');
      cards.forEach(card => {
        const qLabel = card.querySelector('.q-label');
        const qText = qLabel ? qLabel.textContent.replace(/^Q/, '').trim() : '';
        const parts = [];

        // text-input
        const textInputs = card.querySelectorAll('.text-input');
        textInputs.forEach(t => { if (t.value.trim()) parts.push(t.value.trim()); });

        // self-fill
        const selfFills = card.querySelectorAll('.self-fill');
        selfFills.forEach(s => { if (s.value.trim()) parts.push('✎ ' + s.value.trim()); });

        // textarea
        const textareas = card.querySelectorAll('.text-area');
        textareas.forEach(t => { if (t.value.trim()) parts.push(t.value.trim()); });

        // active chips
        const activeChips = card.querySelectorAll('.chip.active');
        if (activeChips.length) {
          parts.push('【已選】' + Array.from(activeChips).map(c => c.textContent.trim()).join('、'));
        }

        // active color items
        const activeColors = card.querySelectorAll('.color-item.active');
        if (activeColors.length) {
          const colText = Array.from(activeColors).map(c => {
            const name = c.querySelector('.color-name');
            return name ? name.textContent.trim() : '';
          }).filter(Boolean).join('、');
          if (colText) parts.push('【顏色】' + colText);
        }

        // active weather
        const activeWeather = card.querySelectorAll('.weather-item.active');
        if (activeWeather.length) {
          const wText = Array.from(activeWeather).map(w => {
            const name = w.querySelector('.weather-name');
            return name ? name.textContent.trim() : '';
          }).filter(Boolean).join('、');
          if (wText) parts.push('【天氣】' + wText);
        }

        // active MBTI
        const activeMbti = card.querySelectorAll('.mbti-cell.active');
        if (activeMbti.length) {
          parts.push('【MBTI】' + Array.from(activeMbti).map(m => m.textContent.trim()).join('、'));
        }

        // slider
        const sliderEl = card.querySelector('.energy-slider');
        if (sliderEl) {
          const val = sliderEl.value;
          const label = document.getElementById('sliderLabel');
          const labText = label ? label.textContent : '';
          parts.push('數值：' + val + '（' + labText + '）');
        }

        if (parts.length) {
          answers.push({ type: 'question', q: qText, answer: parts.join('\n') });
        }
      });
    });

    return answers;
  }

  // ===== 格式化答案為文字 =====
  function formatAnswers(answers) {
    let text = '關於我的一封信\n';
    text += '— 填寫完成 · ' + new Date().toLocaleDateString('zh-TW') + ' —\n\n';

    answers.forEach(item => {
      if (item.type === 'section') {
        text += '\n▎' + item.title + ' ' + (item.en ? '(' + item.en + ')' : '') + '\n';
        text += '─'.repeat(30) + '\n';
      } else if (item.type === 'question') {
        text += '\n▸ ' + item.q + '\n';
        text += '  ' + item.answer.replace(/\n/g, '\n  ') + '\n';
      }
    });

    text += '\n' + '─'.repeat(30) + '\n';
    text += '感謝你認真填寫 · 2026 · Aurevny.\n';
    return text;
  }

  // ===== 填寫到 print-answer 區域 =====
  function fillPrintAnswers(answers) {
    const sections = document.querySelectorAll('.section');
    const questions = answers.filter(a => a.type === 'question');

    sections.forEach(sec => {
      const cards = sec.querySelectorAll('.q-card');
      cards.forEach(card => {
        const printDiv = card.querySelector('.print-answer');
        if (!printDiv) return;
        const qLabel = card.querySelector('.q-label');
        const qText = qLabel ? qLabel.textContent.replace(/^Q/, '').trim() : '';
        const found = questions.find(q => q.q === qText);
        if (found) {
          printDiv.textContent = '✓ ' + found.answer;
        }
      });
    });
  }

  // ===== Submit 按鈕 =====
  function handleSubmit() {
    const btn = document.querySelector('.submit-btn span:first-child');
    const btnArrow = document.querySelector('.submit-btn .arrow');
    btn.textContent = '正在整理 ...';
    if (btnArrow) btnArrow.style.display = 'none';

    try {
      const answers = collectAnswers();

      if (answers.filter(a => a.type === 'question').length === 0) {
        alert('請至少填寫一題再提交哦～');
        btn.textContent = '完成問卷';
        if (btnArrow) btnArrow.style.display = '';
        return;
      }

      fillPrintAnswers(answers);

      const resultText = formatAnswers(answers);
      document.getElementById('resultContent').textContent = resultText;
      document.getElementById('resultPanel').classList.add('show');

      btn.textContent = '已提交 ✦';
      setTimeout(() => {
        btn.textContent = '完成問卷';
        if (btnArrow) btnArrow.style.display = '';
      }, 4000);

    } catch(err) {
      console.error('提交失敗：', err);
      alert('提交時發生錯誤，請重試');
      btn.textContent = '完成問卷';
      if (btnArrow) btnArrow.style.display = '';
    }
  }

  // ===== 關閉結果彈窗 =====
  function closeResult() {
    document.getElementById('resultPanel').classList.remove('show');
  }

  // ===== 複製答案 =====
  function copyAnswers() {
    const text = document.getElementById('resultContent').textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => {
        alert('已複製到剪貼板！直接貼到微信發給我就行 ✦');
      }).catch(() => {
        fallbackCopy(text);
      });
    } else {
      fallbackCopy(text);
    }
  }

  function fallbackCopy(text) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      alert('已複製到剪貼板！直接貼到微信發給我就行 ✦');
    } catch(e) {
      alert('複製失敗，請手動選取文字複製');
    }
    document.body.removeChild(ta);
  }

  // ===== 下載 TXT =====
  function exportTXT() {
    const text = document.getElementById('resultContent').textContent;
    const blob = new Blob(['\uFEFF' + text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = '關於我的一封信_' + new Date().toISOString().slice(0,10).replace(/-/g,'') + '.txt';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // ===== 點擊彈窗背景關閉 =====
  document.getElementById('resultPanel').addEventListener('click', e => {
    if (e.target === document.getElementById('resultPanel')) {
      closeResult();
    }
  });
</script>
<!-- ===================== 補丁：iOS Safari 友好 + 打印優化 ===================== -->
    <script>
    /* ---------- 1. 偵測 iOS Safari ---------- */
    function isIOSSafari() {
      const ua = navigator.userAgent;
      const isIOS = /iP(ad|hone|od)/.test(ua);
      const isSafari = /^((?!chrome|android).)*safari/i.test(ua) || 
                       (navigator.vendor && navigator.vendor.includes('Apple'));
      return isIOS && isSafari;
    }
    
    /* ---------- 2. 手機端隱藏「列印 PDF」按鈕 ---------- */
    if (isIOSSafari()) {
      document.addEventListener('DOMContentLoaded', () => {
        const printBtn = document.querySelector('.btn-print');
        if (printBtn) {
          printBtn.style.display = 'none';
        }
        // 提示用戶用複製 / TXT
        const footer = document.querySelector('.footer p');
        if (footer) {
          footer.innerHTML += '<br><span style="font-size:11px;color:var(--elephant);">iOS 建議使用「複製答案」或「下載 .txt」</span>';
        }
      });
    }
    
    /* ---------- 3. 打印前：把交互控件替換成純文本 ---------- */
    function preparePrintFriendly() {
      // 社交電量滑桿
      document.querySelectorAll('.social-slider input[type="range"]').forEach(slider => {
        const val = slider.value;
        let desc = '平衡型';
        if (val <= 3) desc = '極度內向';
        else if (val <= 5) desc = '偏內向';
        else if (val <= 7) desc = '平衡型';
        else if (val <= 9) desc = '偏外向';
        else desc = '永動機';
    
        const wrapper = slider.closest('.social-slider');
        if (wrapper && !wrapper.querySelector('.print-value')) {
          const span = document.createElement('span');
          span.className = 'print-value';
          span.style.cssText = 'display:none;font-size:14px;color:#1c1c1c;';
          span.textContent = `社交電量：${val}/10（${desc}）`;
          wrapper.appendChild(span);
        }
      });
    
      // Chip 選中項 → 純文字
      document.querySelectorAll('.chips').forEach(group => {
        if (group.querySelector('.print-chips')) return;
        const selected = Array.from(group.querySelectorAll('.chip.selected'))
          .map(c => c.textContent.trim())
          .join('、');
        if (selected) {
          const span = document.createElement('span');
          span.className = 'print-chips';
          span.style.cssText = 'display:none;font-size:14px;color:#1c1c1c;';
          span.textContent = '已選：' + selected;
          group.parentNode.insertBefore(span, group.nextSibling);
        }
      });
    
      // 顏色選中 → 純文字
      document.querySelectorAll('.color-grid').forEach(grid => {
        if (grid.querySelector('.print-colors')) return;
        const selected = Array.from(grid.querySelectorAll('.color-swatch.selected'))
          .map(c => c.getAttribute('data-name') || '')
          .filter(Boolean)
          .join('、');
        if (selected) {
          const span = document.createElement('span');
          span.className = 'print-colors';
          span.style.cssText = 'display:none;font-size:14px;color:#1c1c1c;';
          span.textContent = '喜歡的顏色：' + selected;
          grid.parentNode.insertBefore(span, grid.nextSibling);
        }
      });
    
      // 天氣 icon → 純文字
      document.querySelectorAll('.weather-icons').forEach(group => {
        if (group.querySelector('.print-weather')) return;
        const selected = Array.from(group.querySelectorAll('.weather-icon.selected'))
          .map(w => w.getAttribute('data-name') || '')
          .filter(Boolean)
          .join('、');
        if (selected) {
          const span = document.createElement('span');
          span.className = 'print-weather';
          span.style.cssText = 'display:none;font-size:14px;color:#1c1c1c;';
          span.textContent = '喜歡的天氣：' + selected;
          group.parentNode.insertBefore(span, group.nextSibling);
        }
      });
    
      document.body.classList.add('print-mode');
    }
    
    /* ---------- 4. 綁定列印按鈕 ---------- */
    document.addEventListener('DOMContentLoaded', () => {
      const printBtn = document.querySelector('.btn-print');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          preparePrintFriendly();
          setTimeout(() => {
            window.print();
            document.body.classList.remove('print-mode');
          }, 100);
        });
      }
    });
    </script>
    
    <style>
    /* ===================== 打印專用樣式 ===================== */
    @media print {
      @page { size: A4; margin: 14mm; }
    
      html, body {
        width: 210mm !important;
        height: auto !important;
        background: #fff !important;
        color: #1c1c1c !important;
        font-family: "Noto Serif CJK SC", "Noto Serif SC", serif !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    
      /* 隱藏所有交互控件 */
      button, .no-print, .social-slider input, .chips, .color-grid, .weather-icons, .self-fill, textarea, input {
        display: none !important;
      }
    
      /* 顯示打印態純文字 */
      .print-value, .print-chips, .print-colors, .print-weather {
        display: block !important;
        margin: 4px 0 12px 0 !important;
        font-size: 14px !important;
        color: #1c1c1c !important;
      }
    
      /* 打平佈局，Safari 最穩 */
      .row, .card, .section {
        display: block !important;
        position: static !important;
        transform: none !important;
        box-shadow: none !important;
        break-inside: avoid;
        page-break-inside: avoid;
      }
    
      .card {
        border: 1px solid #ddd !important;
        padding: 4mm !important;
        margin-bottom: 6mm !important;
      }
    
      h1, h2, h3 {
        color: #1c1c1c !important;
        break-after: avoid;
        page-break-after: avoid;
      }
    
      /* 隱藏裝飾性元素 */
      .decoration, .vertical-text, .gold-line {
        display: none !important;
      }
    
      .footer {
        margin-top: 10mm;
        font-size: 11px !important;
        color: #666 !important;
      }
    }
    </style>
    <!-- ===================== 補丁結束 ===================== -->
</body>
